# =============================================================================
# Kavya Shaw Developer Portfolio - Environment Variables
# =============================================================================

# Optional: Email Service Provider for Contact Form Delivery
# If left empty, the contact form falls back gracefully to client-side mailto composer.
RESEND_API_KEY=

# Optional: Custom recipient address (defaults to kavyashaw39@gmail.com)
CONTACT_RECIPIENT_EMAIL=kavyashaw39@gmail.com

# Optional: Public site URL for production OpenGraph and canonical headers
NEXT_PUBLIC_SITE_URL=https://kavya-portfolio-plum.vercel.app
